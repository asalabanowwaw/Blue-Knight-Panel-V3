# Behind any HTTPS frontend that forwards WebSockets to Node:
PORT=8080
PUBLIC_URL=https://proxy.example.com

# For direct VPS hosting, remove PUBLIC_URL and set DOMAIN instead.
# DOMAIN=proxy.example.com

# Optional external endpoint overrides:
# PUBLIC_PORT=443
# PUBLIC_TLS=true

# Optional: learn scheme/port from proxy headers instead of PUBLIC_URL.
# Use only behind a proxy that overwrites forwarded headers.
# TRUST_PROXY=true

# Set fixed credentials in your deployment environment.
# UUID=
# PANEL_PASSWORD=
# SUB_TOKEN=
